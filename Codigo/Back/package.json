{
  "name": "reserwaya-back",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ReservaYa backend — arquitectura hexagonal, MongoDB, OIDC Keycloak",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/entrypoints/http/server.ts",
    "start": "tsx src/entrypoints/http/server.ts",
    "build": "tsc -p tsconfig.json",
    "build:lambda": "esbuild src/entrypoints/lambda/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist-lambda/index.cjs && esbuild src/entrypoints/lambda/scheduled.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist-lambda/scheduled.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/seed/seed.ts",
    "db:local": "docker compose up -d mongo && sleep 2 && mongosh \"mongodb://localhost:27017/reservaya\" --file scripts/schema/setup-reservaya-atlas.js"
  },
  "dependencies": {
    "bson": "^7.3.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "mongodb": "^7.6.0",
    "serverless-http": "^4.0.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
