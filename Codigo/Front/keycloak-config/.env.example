# Plantilla de secretos para la configuracion de Keycloak.
# Copiar como .env (o secrets.env) en el servidor y rellenar desde el gestor de secretos.
# NUNCA versionar el archivo resultante.

# docker-compose.yml / user-data.sh
POSTGRES_PASSWORD=
KC_DB_PASSWORD=
KC_BOOTSTRAP_ADMIN_PASSWORD=

# configure-realm.sh (se leen desde secrets.env en el mismo directorio)
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
DAVID_USER=
DAVID_PASSWORD=
