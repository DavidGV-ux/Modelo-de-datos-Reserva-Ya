# ===== ReservaYa-Whatsapp .env =====
# Copia este archivo a .env y llena los valores antes de desplegar.
NODE_ENV=production
PORT=3000

# --- WhatsApp Cloud API (Meta Developers) ---
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
# Phone Number ID de la app Meta de ReservaYa (número de teléfono de envío)
WHATSAPP_PHONE_ID=
# Token de acceso permanente del System User de Meta
WHATSAPP_TOKEN=
# Verify token que TÚ eliges y configuras en la app de Meta (Webhooks > Verify token)
WHATSAPP_VERIFY_TOKEN=
# App Secret de Met a (App settings > Basic) para verificar firma X-Hub-Signature-256
WHATSAPP_APP_SECRET=
# Plantilla aprobada para el primer contacto (Meta exige plantilla si el usuario nunca ha escrito)
WHATSAPP_WELCOME_TEMPLATE=bienvenida_reservaya
WHATSAPP_WELCOME_TEMPLATE_LANG=es

# --- Groq ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=200
GROQ_TEMPERATURE=0.1
GROQ_INTENT_TIMEOUT_MS=8000

# --- ReservaYa Backend ---
# Base pública del Back: https://8lsipmj4x4.execute-api.us-east-1.amazonaws.com/api
RESERVAYA_API_URL=
# Debe ser IGUAL a WHATSAPP_BOT_SECRET configurado en el Back (para /api/public/whatsapp/lookup)
RESERVAYA_BOT_SECRET=
# Token que el bot exige al Back al publicar eventos (autorización del /internal/events)
RESERVAYA_EVENTS_TOKEN=
RESERVAYA_TIMEOUT_MS=10000

# --- Base de datos propia (Atlas, misma cluster, BD independiente reserva_ya_whatsapp) ---
MONGODB_URI=
MONGODB_DATABASE=reserva_ya_whatsapp

# --- Otros ---
DEFAULT_CITY=Bogotá
ADMIN_SECRET=
BLOCKED_USERS=